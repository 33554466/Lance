# ~/.config/systemd/user/assistant-audio.service
#
# Owns the sound devices. Never touches the network beyond localhost.
# Starts after core, but reconnects on its own if core restarts, so the
# ordering is a convenience rather than a requirement.

[Unit]
Description=Assistant audio pipeline
After=assistant-core.service pipewire.service
Wants=assistant-core.service
# Degrade, never die. This belongs in [Unit]; it was in [Service], which
# systemd still honours but warns about.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/assistant
# The venv is never "activated" under systemd, so put its bin/ on PATH for
# any subprocess that expects to find its tools there. speaker.py resolves
# piper explicitly and does not rely on this, but anything added later might.
Environment=PATH=%h/assistant/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/assistant/.venv/bin/python -m audio.service
Restart=always
RestartSec=3
# Model loading takes ~20s on first start. Note this is decorative with
# Type=simple — startup "completes" at exec — and is kept only as a marker
# for the day this becomes Type=notify.
TimeoutStartSec=180
# The one timeout that actually bites. A process wedged on the sound card
# otherwise gets the default 90 seconds before SIGKILL, which is 90 seconds
# of a deaf appliance every time you restart it.
TimeoutStopSec=10

# NoNewPrivileges is deliberately absent: audio/usbpower.py escalates to
# `sudo -n uhubctl` as part of the microphone recovery ladder, and
# NoNewPrivileges kills setuid.
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=default.target
