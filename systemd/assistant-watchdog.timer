# ~/.config/systemd/user/assistant-watchdog.timer
#
#   systemctl --user enable --now assistant-watchdog.timer
#   systemctl --user list-timers 'assistant*'

[Unit]
Description=Run the assistant health check every minute

[Timer]
# Two minutes after boot: long enough for the audio service to load Whisper
# and connect, so the first check is not a false alarm that restarts a
# service which was starting perfectly well.
OnBootSec=2min
OnUnitActiveSec=1min
# Do not stack if one run is slow.
AccuracySec=10s

[Install]
WantedBy=timers.target
